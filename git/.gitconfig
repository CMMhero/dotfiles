[core]
	editor = fresh
	# delta renders diffs in the same Catppuccin Macchiato palette as bat, fzf,
	# wezterm, superfile and omp. It wraps any pager input, so it also applies to
	# `git log`, `git show` and friends.
	pager = delta
	# hunk is still the interactive diff reviewer for `git difftool` below; only
	# the scrolling pager changed.

[delta]
	theme = dark "Catppuccin Macchiato"
	# Keep the hunk pager available for anything that wants it explicitly:
	#   git -c core.pager='hunk pager' log -p
	line-numbers = true
	side-by-side = false
	navigate = true
	hyperlinks = true

[init]
	defaultBranch = main

[user]
	email = ch.mh.marvelio@gmail.com
	name = Christopher Matthew Marvelio

[pull]
  rebase = true

[push]
  autoSetupRemote = true

[branch]
  sort = -committerdate

[checkout]
  defaultRemote = origin

[fetch]
  prune = true

[rerere]
   enabled = true

[merge]
  conflictStyle = zdiff3

# `hunk difftool` takes git difftool's exact argument shape
# (<local> <remote> [path]), so wiring it as diff.tool makes it what runs when
# lazygit's OpenDiffTool keybinding shells out to `git difftool <file>`.
# lazygit 0.65 removed its own git.diffCommands setting, so this lives here.
[diff]
	tool = hunk
[difftool "hunk"]
	cmd = hunk difftool "$LOCAL" "$REMOTE"
[difftool]
	prompt = false
