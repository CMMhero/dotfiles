[core]
	editor = fresh
	# hunk is the pager. It detects diff output and renders it in its own
	# review UI instead of a scrollback, and falls back to a plain pager for
	# non-diff output such as `git log --oneline`.
	pager = hunk pager

[delta]
	# delta is kept configured (Catppuccin Macchiato, side-by-side) for explicit
	# use: `git diff | delta --paging=never`. It is not the pager, and lazygit
	# cannot use it at all -- see the lazygit config.
	theme = dark "Catppuccin Macchiato"
	line-numbers = true
	# side-by-side needs room; delta falls back to unified on a narrow terminal.
	side-by-side = true
	# Side-by-side plus line numbers needs ~120 columns to stay readable.
	side-by-side-only = false
	navigate = true
	hyperlinks = true

[init]
	defaultBranch = main

[user]
	email = ch.mh.marvelio@gmail.com
	name = Christopher Matthew Marvelio

[pull]
  rebase = true

[push]
  autoSetupRemote = true

[branch]
  sort = -committerdate

[checkout]
  defaultRemote = origin

[fetch]
  prune = true

[rerere]
   enabled = true

[merge]
  conflictStyle = zdiff3
