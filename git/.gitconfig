[core]
	editor = fresh
	# delta renders diffs in the same Catppuccin Macchiato palette as bat, fzf,
	# wezterm, superfile and omp. It wraps any pager input, so it also applies to
	# `git log`, `git show` and friends.
	pager = delta
	# hunk is still the interactive diff reviewer for `git difftool` below; only
	# the scrolling pager changed.

[delta]
	theme = dark "Catppuccin Macchiato"
	line-numbers = true
	# side-by-side needs room; delta falls back to unified on a narrow terminal.
	side-by-side = true
	# Side-by-side plus line numbers needs ~120 columns to stay readable.
	side-by-side-only = false
	navigate = true
	hyperlinks = true

[init]
	defaultBranch = main

[user]
	email = ch.mh.marvelio@gmail.com
	name = Christopher Matthew Marvelio

[pull]
  rebase = true

[push]
  autoSetupRemote = true

[branch]
  sort = -committerdate

[checkout]
  defaultRemote = origin

[fetch]
  prune = true

[rerere]
   enabled = true

[merge]
  conflictStyle = zdiff3
