# OS / Editor artifacts
.DS_Store
*.swp
*.swo
*~

# Credentials & secrets (never commit auth tokens or private keys)
*auth.json
*.key
*.pem
id_ed25519*
id_rsa*
*.env
*.env.local

# Databases, caches, logs & runtime sockets
*.db
*.db-shm
*.db-wal
*.log
*.sock
*.pid
cache/

# Node / Bun dependencies & lock temporary files
node_modules/
.npm/
.bun/
.cache/
.staging/

# Generated by `pnpm install` in section 10 of install.sh. pnpm resolves the
# stow symlink at omp/.omp/plugins/package.json to its real path in this repo,
# so the lockfile is written here rather than into ~/.omp/plugins.
omp/.omp/plugins/pnpm-lock.yaml

# Fresh editor fetched package registry (regenerated by `fresh --cmd update`)
fresh/.config/fresh/plugins/packages/.index/
fresh/.config/fresh/plugins/packages/.cache/
logs/

# Fresh editor runtime-generated API types (regenerated by `fresh --cmd script types`)
fresh/.config/fresh/types/
fresh/.config/fresh/logs/
fresh/.config/fresh/.staging/

# Backups
*.bak
*.bak-*
*.backup
*.old
*.orig
service.json
