{
  "theme": "https://github.com/sinelaw/fresh-plugins#catppuccin-macchiato",
  "editor": {
    "tab_size": 2,
    "line_numbers": true,
    "show_horizontal_scrollbar": false,
    "indentation_guide": "active",
    "relative_line_numbers": true,
    "completion_popup_auto_show": true,
    "hide_current_line_on_selection": true,
    "nerd_font_icons": true,
    "show_prompt_line": false,
    "search": {
      "confirm_each": true
    },
    "trim_trailing_whitespace_on_save": true,
    "use_terminal_bg": true
  },
  "version": 2,
  "active_keybinding_map": "vscode",
  "locale": "en",
  "orchestrator_mode": false,
  "file_explorer": {
    "show_gitignored": true,
    "show_hidden": true
  },
  "file_browser": {
    "show_hidden": true
  },
  "lsp": {
    "toml": {
      "enabled": true,
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
      }
    }
  },
  "plugins": {
    "dashboard": {
      "settings": {
        "autoOpen": true
      }
    }
  }
}